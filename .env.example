# Configuration reference only: PowerShell must set $env:NAME explicitly.
# The application does not automatically load .env files.
# SECRET_KEY=<generate a long random value and store it outside source control>
HOST=127.0.0.1
PORT=8080
HOMEWORK_HTTPS=0
TEACHER_REGISTRATION_CODE=
# SMTP: use the provider's SMTP authorization code, not your mailbox login password.
# QQ example: smtp.qq.com / 465 / SSL; enable SMTP in mailbox settings first.
MAIL_SERVER=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_USE_SSL=1
MAIL_USE_TLS=0
# For STARTTLS on port 587, set MAIL_USE_SSL=0 and MAIL_USE_TLS=1.
# HOMEWORK_DATABASE_URI=sqlite:///D:/homework-data/homework.db
# HOMEWORK_UPLOAD_FOLDER=D:/homework-data/uploads
# HOMEWORK_LOG_DIR=D:/homework-data/logs
